# Generated by ~/.local/bin/theme from ~/.config/themes/tokyonight/theme.conf.

# Main bg
theme[main_bg]="#222436"

# Main text color
theme[main_fg]="#c8d3f5"

# Title color for boxes
theme[title]="#c8d3f5"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#86e1fc"

# Background color of selected item in processes box
theme[selected_bg]="#2f334d"

# Foreground color of selected item in processes box
theme[selected_fg]="#c8d3f5"

# Color of inactive/disabled text
theme[inactive_fg]="#7983a4"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#86e1fc"

# Cpu box outline color
theme[cpu_box]="#454c65"

# Memory/disks box outline color
theme[mem_box]="#454c65"

# Net up/down box outline color
theme[net_box]="#454c65"

# Processes box outline color
theme[proc_box]="#454c65"

# Box divider line and small boxes line color
theme[div_line]="#2f334d"

# Temperature graph colors
theme[temp_start]="#9ece6a"
theme[temp_mid]="#ffc777"
theme[temp_end]="#f7768e"

# CPU graph colors
theme[cpu_start]="#82aaff"
theme[cpu_mid]="#bb9af7"
theme[cpu_end]="#f7768e"

# Mem/Disk free meter
theme[free_start]="#9ece6a"
theme[free_mid]="#82aaff"
theme[free_end]="#c8d3f5"

# Mem/Disk cached meter
theme[cached_start]="#86e1fc"
theme[cached_mid]="#86e1fc"
theme[cached_end]="#82aaff"

# Mem/Disk available meter
theme[available_start]="#9ece6a"
theme[available_mid]="#86e1fc"
theme[available_end]="#82aaff"

# Mem/Disk used meter
theme[used_start]="#9ece6a"
theme[used_mid]="#ffc777"
theme[used_end]="#f7768e"

# Download graph colors
theme[download_start]="#82aaff"
theme[download_mid]="#86e1fc"
theme[download_end]="#9ece6a"

# Upload graph colors
theme[upload_start]="#bb9af7"
theme[upload_mid]="#bb9af7"
theme[upload_end]="#82aaff"
